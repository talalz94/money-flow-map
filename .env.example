# Copy this file to `.env` (git-ignored) and fill in what you have. Every key is optional:
# a missing key switches off only the source that needs it, and the dashboard says so.
#
# Instead of copying values, you can point `[keys] env_files` in moneyflow.toml at another
# project's .env file; the values are read at runtime and never printed, logged or saved.

# Alpaca (free "Basic" market-data plan): real-time IEX prices for TLT/IEF/HYG and the ETF
# reference quotes, plus the real-time news stream.  https://app.alpaca.markets -> API keys
ALPACA_KEY_ID=
ALPACA_SECRET=

# Finnhub (free key): real-time OANDA FX for the computed DXY, and the general news feed.
# https://finnhub.io/register
FINNHUB_KEY=

# FRED (free key): daily Treasury yields and credit spreads for the 10Y tile and context.
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Not needed: Binance, Coinbase, Hyperliquid, CoinGecko, DefiLlama, Cboe, the Fed and the RSS
# feeds are public. Binance keys are never used (market data only, nothing places orders).
